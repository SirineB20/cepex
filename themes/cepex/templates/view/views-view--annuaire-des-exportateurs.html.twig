

{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}
  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}
 <div class="titre-success-storie">
      <span>{{ view.title }}</span>
  </div>    
      <div class="clearfix text-formatted field field--name-field-decsription-annuaire field--type-text-long field--label-above"> 
      <p style="    font-size: 17px;
    color: #000;
    text-align: center;"><span>Découvrez notre Annuaire des Exportateurs, qui recense les entreprises tunisiennes prêtes à saisir des opportunités à l'international. Cet outil pratique vous permet de trouver facilement des partenaires commerciaux 
    et des fournisseurs dans divers secteurs.</p></span>
      </div>
    
 {% if exposed %}
      <div class="container">
      <div class="boxfiltre-guide boxfiltre-export boxfiltre-opportinutes">
          {{ exposed }}
        </div>
     </div>
{% endif %}            
            <div class="container container-interne">
            <div class="flexbox-actualites background-map">
            {{ rows }}
            </div>
          </div>
{% if pager is defined and pager %}
    <nav aria-label="Page navigation" class="paginator-guide">
      {{ pager }}
    </nav>
  {% endif %}
{% if footer %}
  <div class="view-footer">
    {{ footer }}
  </div>
{% endif %}
