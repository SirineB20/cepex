{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ row.attributes.addClass(row_classes) }}>
   <div class="container">
      <div class="boxfiltre-guide boxfiltre-export boxfiltre-opportinutes">
          {{ exposed }}
        </div>
     </div>

  {# Contenu des actualités #}
 <div class="section-support nobg" style="padding-top: 0;">
 <div class="container">
 <div class="tab-content tabs-content">
 <div class="box" style="display: block;">
  {% if rows is defined and rows %}
      {{ rows }}
  {% endif %}
  </div>
</div>
</div>
</div>
  {# Pagination #}
  {% if pager is defined and pager %}
    <nav aria-label="Page navigation" class="paginator-guide">
      {{ pager }}
    </nav>
  {% endif %}
</div>
</div>
