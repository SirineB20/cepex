{# Charge la bibliothèque amCharts (JS/CSS) #}

<div class="container container-interne">
  <div class="titlecontenu">
    <span>Bureaux à <span class="colorred">l'étranger</span></span>
  </div>

  <div class="flexbox-maps">
    <div class="boxmaps">
      {# Conteneur VIDE pour le globe. Votre JS (Drupal.behaviors) s'appuie sur cet ID #}
      <div id="chartdiv" style="width:100%; height:500px;"></div>
    </div>

    <div class="detailsmaps">
      {# Affiche les lignes de la vue (détails) APRÈS le globe #}
      {{ rows }}
    </div>
  </div>
</div>
