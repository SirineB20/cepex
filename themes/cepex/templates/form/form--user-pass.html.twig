{#
/**
 * @file
 * Default theme implementation for a 'form' element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 *
 * @ingroup themeable
 */
#}
<div class="login-form page-wrapper bg-light auth-forms">
  <div class="container">
    <div class="row p-20 justify-content-center">
      <div class="col-md-6 text-center">
        <div class="card card-outline-success text-center">
          <div class="card-header">
            <h4 class="m-b-0 text-white">Mot de passe oublié?</h4>
          </div>
          <div class="card-body">
            <form{{ attributes }}>
              <div class="row from-inputs">
                
                <div class="col-lg-12">
                  {{ children }}
                </div>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
