<div class="container event-detail">
  <div class="icone-container">
    <div class="date-event">
      <i class="fa-solid fa-calendar"></i>
      {{ content.field_date_opportunitie }}
    </div>
    <div class="location-event">
      <i class="fa-solid fa-location-dot"></i>
      {{ content.field_lieux }}
    </div>
    <div class="type-event" style="display: flex; gap: 10px;">
      <i class="fa-solid fa-briefcase"></i>
      {{ content.field_secteur_opportunitie }}
    </div>
  </div>
  <div class="socials-events">
    <a href="#" aria-label="Facebook">
      <i class="fa-brands fa-facebook-f"></i>
    </a>
    <a href="#" aria-label="Twitter">
      <i class="fa-brands fa-x-twitter"></i>
    </a>
    <a href="#" aria-label="LinkedIn">
      <i class="fa-brands fa-linkedin-in"></i>
    </a>
  </div>

  <div class="img-devent">
    {% set image_url = content.field_image_oppo.0['#markup'] %}
    <img src="{{ image_url }}" alt="img opportunité" class="event-detail__header-img">
  </div>

  <h2 class="devent-titre">{{ label }}</h2>
  <div class="desc-devent">
    {{ content.field_presentation_opportunitie }}
    {{ content.field_description_complete}}
  </div>
  
  <!-- Bouton pour répondre à l'opportunité -->
  <div class="response-button-container">
    <a href="http://localhost:8087/fr/form/repondre-a-l-opportunite?opportunite_id={{ node.id }}" class="webclique btn-response">
      <i class="fa-solid fa-reply"></i> Répondre à cette opportunité
    </a>
  </div>

  <div class="floating-action-button">
  {% if user_roles is defined and 'rct' in user_roles %}
    <a href="{{ base_path }}fr/dashboard/rct/opportunites-daffaires/{{ pays_code }}/{{ user_id }}" class="btn btn-primary btn-fab" title="Retourner à la gestion">
	{% endif %}
  {% if user_roles is defined and 'exportateur' in user_roles %}
	<a href="http://localhost:8087/fr/dashboard/gestion-produits" title="Aller à la gestion des produits">
{% endif %}
      <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>
</div>