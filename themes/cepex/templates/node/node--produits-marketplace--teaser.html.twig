<div class="boxprod-marketplace boxshadow" style="width: 100%; display: inline-block;">
<div class="boximgprod">
  {% set image_url = content.field_image_produit.0['#markup'] %}
  <img src="{{ image_url }}">
</div>
<div class="boxcontenuprod">
  <span class="titleprod-marketplace">
    {{ content.field_nom_produit }}
  </span>
  <div class="refprod">
    {{ content.field_reference_produit }}
  </div>
  <a href="#" class="btn-cepex btnprod" tabindex="0">Découvrir <i class="fa-solid fa-arrow-right"></i></a>
</div>
</div>