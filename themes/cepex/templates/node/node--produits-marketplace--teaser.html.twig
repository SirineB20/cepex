<div class="borderprod" style="width: 100%; display: inline-block;">
	<div class="boximgprod">
		{% set image_url = content.field_image_produit.0['#markup'] %}
		<img src="{{ image_url }}" class="img-prod-marketplace" alt="Cepex">
	</div>
	
		<span class="titleprod-marketplace">
			{{ content.field_nom_produit }}
		</span>
		<a href="{{ url }}" class="btn-cepex btnprod" tabindex="0">Voir plus
			<i class="fa-solid fa-arrow-right"></i>
		</a>

</div>
