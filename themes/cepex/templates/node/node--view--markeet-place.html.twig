{#
/**
 * @file
 * Default theme implementation to display a product node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 * - label: The title of the node.
 * - content: All node items.
 * - author_picture: The node author user entity.
 * - date: Themed creation date field.
 * - author_name: Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: Same as attributes, for the main title tag.
 * - content_attributes: Same as attributes, for the main content tag.
 * - author_attributes: Same as attributes, for the author tag.
 * - title_prefix: Additional output populated by modules, before the title.
 * - title_suffix: Additional output populated by modules, after the title.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - page: Flag for the full page state.
 *
 * @see template_preprocess_node()
 *
 * @ingroup themeable
 */
#}
<section class="detailsprod-marketplace">
  {# Bouton pour retourner à la page de gestion des produits #}
  

  <div class="container container-interne">
    <div class="flexbox-details-marketplace">
      <div class="col-lg-6 col-md-12 col-sm-12 col-12 boximg-details-marketplace">
        <div class="borderdetails-marketplace">
          {% if content.field_image_produit %}
          
            {% set image_url = content.field_image_produit.0['#markup'] %}
            <img src="{{ image_url }}" class="img-details-marketplace">
          {% endif %}
          <div class="boxpartage-marketplace">
            <span class="icon-partage-marketplace"><i class="fa-solid fa-diagram-project"></i></span>
            <div class="ul-partage">
              <a href="#" class="btn-paratge"><i class="fa-brands fa-facebook-f"></i></a>
              <a href="#" class="btn-paratge"><i class="fa-brands fa-instagram"></i></a>
              <a href="#" class="btn-paratge"><i class="fa-brands fa-linkedin-in"></i></a>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-6 col-md-12 col-sm-12 col-12 boxdetails-marketplace">
        <div class="bgdetails-maretplace">
          <span class="titleprod-details">{{ label }}</span>
          {% if content.field_nom_produit %}
            <span class="subtitleprod-details">{{ content.field_nom_produit }}</span>
          {% endif %}
          {% if content.field_reference_produit %}
            <span class="refprod-details">{{ content.field_reference_produit }}</span>
          {% endif %}
          {% if content.field_description_produit %}
            <span class="description-details">Description</span>
            <p>{{ content.field_description_produit }}</p>
          {% endif %}
          <a href="#" class="btn-cepex btn-devis">Demander un devis <i class="fa-solid fa-arrow-right"></i></a>
          

        </div>
      </div>
    </div>
    
    <div class="col-md-12 col-sm-12 col-12 caract-details-marketplace">
      <span class="title-caract">Caractéristiques</span>
      <div class="nav nav-tabs nav-tabs-details-marketplace" id="nav-tab" role="tablist">
        <button class="nav-link active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-description" type="button" role="tab" aria-controls="nav-description" aria-selected="true">Ingrédiants</button>
        <button class="nav-link" id="nav-profile-tab" data-bs-toggle="tab" data-bs-target="#nav-certificat" type="button" role="tab" aria-controls="nav-certificat" aria-selected="false">Certifications</button>
        <button class="nav-link" id="nav-contact-tab" data-bs-toggle="tab" data-bs-target="#nav-fabriquant" type="button" role="tab" aria-controls="nav-fabriquant" aria-selected="false">Fabriquant</button>
      </div>
      <div class="tab-content tab-details-marketplace" id="nav-tabContent">
        <div class="tab-pane fade show active" id="nav-description" role="tabpanel" aria-labelledby="nav-description-tab">
          <span class="titre-tab">Ingrédiant :</span>
          {% if content.field_ingredients %}
            <span class="details-sub-details">{{ content.field_ingredients }}</span>
          {% endif %}
        </div>
        <div class="tab-pane fade" id="nav-certificat" role="tabpanel" aria-labelledby="nav-certificat-tab">
          {% if content.field_certifications %}
            <span class="titre-tab">Certifications :</span>
            {{ content.field_certifications }}
          {% endif %}
        </div>
        <div class="tab-pane fade" id="nav-fabriquant" role="tabpanel" aria-labelledby="nav-fabriquant-tab">
          {% if content.field_fabriquant %}
            <span class="titre-tab">Information du fabriquant :</span>
            {{ content.field_fabriquant }}
          {% endif %}
        </div>
      </div>
    </div>
    
    {# Bouton flottant pour accéder à la page de gestion des produits #}
    <div class="floating-action-button">
      <a href="http://localhost:8087/fr/dashboard/gestion-produits" title="Aller à la gestion des produits">
        <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>