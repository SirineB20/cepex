<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the cepex theme.
 */

/**
 * Check if language is available before using it.
 */
function cepex_get_language_code() {
  if (\Drupal::hasService('language_manager')) {
    $language = \Drupal::languageManager()->getCurrentLanguage();
    return $language ? $language->getId() : 'fr'; // Default to 'fr' if not available
  }
  return 'fr';
}

/**
 * Implements hook_preprocess_html().
 */
function cepex_preprocess_html(array &$variables): void {
  // Ensure language code is available
  $variables['language_code'] = cepex_get_language_code();
  
  // Add classes for authenticated users
  $current_user = \Drupal::currentUser();
  if ($current_user->id() > 0) {
    $variables['attributes']['class'][] = 'user-logged-in';
    $variables['attributes']['class'][] = 'user-' . $current_user->id();
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function cepex_module_implements_alter(&$implementations, $hook) {
  if ($hook == 'entity_access') {
    // Déplacer notre implémentation à la fin
    if (isset($implementations['cepex'])) {
      $group = $implementations['cepex'];
      unset($implementations['cepex']);
      $implementations['cepex'] = $group;
    }
  }
}

/**
 * Implements hook_entity_access().
 */
function cepex_entity_access(\Drupal\Core\Entity\EntityInterface $entity, $operation, \Drupal\Core\Session\AccountInterface $account) {
  // Pour le débogage
  \Drupal::logger('cepex')->notice('Vérification d\'accès: @type, @bundle, @op', [
    '@type' => $entity->getEntityTypeId(),
    '@bundle' => method_exists($entity, 'bundle') ? $entity->bundle() : 'n/a',
    '@op' => $operation,
  ]);

  // Si c'est un profil exportateur
  if ($entity->getEntityTypeId() == 'profile' && $entity->bundle() == 'profile_exportateur') {
    $uid = $entity->getOwnerId();
    
    // Si l'utilisateur est le propriétaire du profil OU a des droits d'administration
    if ($uid == $account->id() || $account->hasPermission('administer users')) {
      if ($operation == 'view') {
        return \Drupal\Core\Access\AccessResult::allowed();
      }
      
      if ($operation == 'update') {
        return \Drupal\Core\Access\AccessResult::allowed();
      }
    }
  }
  
  // Vérification pour les pages de profil
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name == 'entity.profile.user_profile_form' || 
      $route_name == 'entity.profile.canonical' ||
      $route_name == 'profile.user_page' ||
      strpos($route_name, 'profile_exportateur') !== FALSE) {
      
    $route_user_id = \Drupal::routeMatch()->getParameter('user');
    if (is_object($route_user_id)) {
      $route_user_id = $route_user_id->id();
    }
    
    // Permettre à l'utilisateur d'accéder à son propre profil
    if ($route_user_id && $account->id() == $route_user_id) {
      \Drupal::logger('cepex')->notice('Accès accordé au profil pour uid @uid', ['@uid' => $account->id()]);
      return \Drupal\Core\Access\AccessResult::allowed();
    }
  }

  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_form_alter().
 */
function cepex_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Si c'est le formulaire de profil exportateur
  if (strpos($form_id, 'profile_profile_exportateur_edit_form') !== FALSE) {
    // Ajouter notre propre soumission
    $form['#submit'][] = 'cepex_profile_form_submit';
    
    // Journaliser le form_id pour débogage
    \Drupal::logger('cepex')->notice('Formulaire de profil détecté: @form_id', ['@form_id' => $form_id]);
  }
}

/**
 * Custom submit handler for profile exportateur form.
 */
function cepex_profile_form_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  // Log that our submit handler was called
  \Drupal::logger('cepex')->notice('Formulaire de profil soumis');
  
  // Clear cache for the user to ensure updated profile info is displayed
  $profile = $form_state->getFormObject()->getEntity();
  if ($profile) {
    $uid = $profile->getOwnerId();
    \Drupal\Core\Cache\Cache::invalidateTags(['user:' . $uid]);
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function cepex_preprocess_page(array &$variables): void {
  // Obtenir l'utilisateur actuellement connecté.
  $current_user = \Drupal::currentUser();

  // Vérifier si l'utilisateur est connecté (ID > 0).
  if ($current_user->id() > 0) {
    // Définir les variables liées à l'utilisateur connecté.
    $variables['user_logged_in'] = TRUE;
    $variables['user_id'] = $current_user->id();
    $variables['user_roles'] = $current_user->getRoles();

    try {
      // Charger le profil de type "profile_exportateur" associé à l'utilisateur.
      $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
      $profiles = $profile_storage->loadByProperties([
        'uid' => $current_user->id(),
        'type' => 'profile_exportateur',
      ]);

      // Récupérer le nom de l'entreprise depuis le profil si disponible.
      if (!empty($profiles)) {
        $profile = reset($profiles);

        if (
          $profile->hasField('field_nom_de_l_entreprise') &&
          !$profile->get('field_nom_de_l_entreprise')->isEmpty()
        ) {
          $variables['entreprise_name'] = $profile->get('field_nom_de_l_entreprise')->value;
        } else {
          $variables['entreprise_name'] = $current_user->getDisplayName();
        }
      } else {
        // Si aucun profil exportateur n'existe, fallback sur le nom d'utilisateur.
        $variables['entreprise_name'] = $current_user->getDisplayName();
      }
    } 
    catch (\Exception $e) {
      // Log error but continue
      \Drupal::logger('cepex')->error('Error loading profile: @message', ['@message' => $e->getMessage()]);
      $variables['entreprise_name'] = $current_user->getDisplayName();
    }
  } else {
    // Si l'utilisateur n'est pas connecté.
    $variables['user_logged_in'] = FALSE;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page.
 */
function cepex_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  
  // Add template suggestions for profile pages
  if (strpos($route_name, 'profile') !== FALSE) {
    $suggestions[] = 'page__profile';
    
    if (strpos($route_name, 'profile_exportateur') !== FALSE) {
      $suggestions[] = 'page__profile__exportateur';
    }
  }
}