<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the cepex theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function cepex_preprocess_html(array &$variables): void {

}
/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */

function cepex_preprocess_page(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $variables['nid'] = NULL;
  // Gestion des utilisateurs connectés
  if ($current_user->id() > 0) {
    // Charger l'objet utilisateur complet pour avoir accès à toutes ses propriétés
    $user = \Drupal\user\Entity\User::load($current_user->id());

    // Ajouter les variables de l'utilisateur connecté au tableau $variables
    $variables['user_logged_in'] = TRUE;
    $variables['user_name'] = $user->getDisplayName();
    $variables['user_id'] = $user->id();
    $variables['user_roles'] = $user->getRoles();
    
    // Charger le profil exportateur associé à cet utilisateur
    $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
    $profiles = $profile_storage->loadByProperties([
      'uid' => $user->id(),
      'type' => 'profile_exportateur', // Le type de profile
    ]);
    
    if (!empty($profiles)) {
      $profile = reset($profiles);
      if ($profile->hasField('field_nom_de_l_entreprise') && !$profile->get('field_nom_de_l_entreprise')->isEmpty()) {
        $variables['entreprise_name'] = $profile->get('field_nom_de_l_entreprise')->value;
      } else {
        $variables['entreprise_name'] = $user->getDisplayName();
      }
    } else {
      $variables['entreprise_name'] = $user->getDisplayName();
    }
    
    // Ajouter l'ID du secteur pour l'homme secteur connecté
    if (in_array('homme_secteur', $user->getRoles())) {
      // Vérifier si l'information est stockée directement dans le profil utilisateur
      if ($user->hasField('field_secteur') && !$user->get('field_secteur')->isEmpty()) {
        $variables['id_secteur_homme_secteur'] = $user->get('field_secteur')->target_id;
      } 
      // Sinon, chercher dans le profil homme_secteur
      else {
        $homme_secteur_profiles = $profile_storage->loadByProperties([
          'uid' => $user->id(),
          'type' => 'profile_homme_secteur', // Ajustez selon votre type de profil
        ]);
        
        if (!empty($homme_secteur_profiles)) {
          $homme_secteur_profile = reset($homme_secteur_profiles);
          if ($homme_secteur_profile->hasField('field_secteur') && !$homme_secteur_profile->get('field_secteur')->isEmpty()) {
            $variables['id_secteur_homme_secteur'] = $homme_secteur_profile->get('field_secteur')->target_id;
          }
        }
      }
    }
    
    // Ajouter l'ID du pays pour le RCT connecté
    if (in_array('rct', $user->getRoles())) {
      // Vérifier si l'information est stockée directement dans le profil utilisateur
      if ($user->hasField('field_pays') && !$user->get('field_pays')->isEmpty()) {
        // Option 1: Si c'est une référence d'entité standard
        $variables['pays_code'] = $user->get('field_pays')->target_id;
        
        // Option 2: Si c'est un champ country avec valeur directe
        if ($user->get('field_pays')->value) {
          $variables['pays_code'] = $user->get('field_pays')->value;
        }
      }
      // Sinon, chercher dans le contenu de type "rct"
      else {
        // Rechercher le contenu RCT associé à cet utilisateur
        $query = \Drupal::entityQuery('node')
          ->condition('type', 'rct')
          ->condition('uid', $current_user->id())
          ->accessCheck(FALSE)
          ->range(0, 1);
        
        $nids = $query->execute();
        
        if (!empty($nids)) {
          $nid = reset($nids);
          $variables['rct_node_id'] = $nid;
          // Charger le nœud RCT
          $node = \Drupal\node\Entity\Node::load($nid);
          
          if ($node && $node->hasField('field_pays') && !$node->get('field_pays')->isEmpty()) {
            // Option 2: Si c'est un champ country avec valeur directe
            if ($node->get('field_pays')->value) {
              $variables['pays_code'] = $node->get('field_pays')->value;
            }
          }
        }
      }
    }
  } else {
    // Si l'utilisateur n'est pas connecté
    $variables['user_logged_in'] = FALSE;
  }
}
use Drupal\Core\Form\FormStateInterface;

/**
 * Helper function to apply common form styles.
 */
function _cepex_apply_common_form_styles(&$variables, $form_id) {
  // Ajouter une classe au formulaire
  $variables['attributes']['class'][] = $form_id;
  
  // Ajouter d'autres styles communs si nécessaire
  // Par exemple :
  $variables['attributes']['class'][] = 'styled-form';
}

function cepex_preprocess_views_exposed_form(&$variables) {
  if (!isset($variables['form']['#id'])) {
    return;
  }

  $form_id = $variables['form']['#id'];

  // Vérifier si c'est le formulaire de vue "market_place" que nous voulons cibler
  if ($form_id == 'views-exposed-form-market-place-page-1') {
    // Ajouter une classe au formulaire
    $variables['attributes']['class'][] = 'views-exposed-form-mareet-place-page-1';
  }
  // Cibler spécifiquement le formulaire exposé "gestion-produit-par-exportateur-page-1"
  elseif ($form_id == 'views-exposed-form-gestion-produit-par-exportateur-page-1') {
    _cepex_apply_common_form_styles($variables, $form_id);
    
    // Améliorer le champ de recherche
    if (isset($variables['form']['title'])) {
      $variables['form']['title']['#attributes']['placeholder'] = t('Chercher le produit par son titre');
      $variables['form']['title']['#attributes']['class'][] = 'form-control';
      $variables['form']['title']['#attributes']['class'][] = 'search-input-styled';
    }
  }
  // Cibler le formulaire exposé "gestion-exportateurs"
  elseif ($form_id == 'views-exposed-form-gestion-exportateurs-page-1') {
    _cepex_apply_common_form_styles($variables, $form_id);
    
    // Améliorer le champ Matricule fiscale
    if (isset($variables['form']['field_matricule_fiscale_value'])) {
      $variables['form']['field_matricule_fiscale_value']['#attributes']['placeholder'] = t('Entrez le matricule fiscale');
      $variables['form']['field_matricule_fiscale_value']['#attributes']['class'][] = 'form-control';
      $variables['form']['field_matricule_fiscale_value']['#attributes']['class'][] = 'search-input-styled';
    }
    
    // Améliorer le champ Nom de l'entreprise
    if (isset($variables['form']['field_nom_de_l_entreprise_value'])) {
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['placeholder'] = t('Entrez le nom de l\'entreprise');
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['class'][] = 'form-control';
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['class'][] = 'search-input-styled';
    }
  }
  // Cibler le formulaire exposé "les-produits-de-l-exportateur"
  elseif ($form_id == 'views-exposed-form-les-produits-de-l-exportateur-page-1') {
    _cepex_apply_common_form_styles($variables, $form_id);
    
    // Améliorer le champ Matricule fiscale
    if (isset($variables['form']['field_matricule_fiscale_value'])) {
      $variables['form']['field_matricule_fiscale_value']['#attributes']['placeholder'] = t('Entrez le matricule fiscale');
      $variables['form']['field_matricule_fiscale_value']['#attributes']['class'][] = 'form-control';
      $variables['form']['field_matricule_fiscale_value']['#attributes']['class'][] = 'search-input-styled';
    }
    
    // Améliorer le champ Nom de l'entreprise
    if (isset($variables['form']['field_nom_de_l_entreprise_value'])) {
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['placeholder'] = t('Entrez le nom de l\'entreprise');
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['class'][] = 'form-control';
      $variables['form']['field_nom_de_l_entreprise_value']['#attributes']['class'][] = 'search-input-styled';
    }
  }
}


/**
 * Implements hook_theme_suggestions_views_view_alter().
 */
function cepex_suggestions_views_view_alter(array &$suggestions, array $variables) {
  // Get the View object.
  $view = $variables['view'];
  // Check if the View's ID is 'les_opportunites_d_affaires'.
  if ($view->id() == 'les_opportunites_d_affaires') {
    // Add a template suggestion: views-view--les-opportunites-d-affaires.
    $suggestions[] = 'views_view__' . $view->id();
    // Optionally, add a suggestion for the specific display (e.g., page_1).
    $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
  }
}
/**
 * Implements hook_form_alter().
 */
function cepex_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {

  
  if (strpos($form_id, 'webform_submission_formulaire_de_contact_') === 0) {
    // Obtenez le paramètre service de l'URL
    $service = \Drupal::request()->query->get('service');
    
    if (!empty($service)) {
      // Définissez la valeur par défaut du champ service
      if (isset($form['elements']['service'])) {
        $form['elements']['service']['#default_value'] = urldecode($service);
      }
    }
  }
  if ($form_id === 'webform_submission_repondre_a_l_opportunite_add_form' || strpos($form_id, 'webform_submission_repondre_a_l_opportunite_') === 0) {
  // Attach the custom CSS library
  $form['#attached']['library'][] = 'cepex/form-contact';
  
  // Get URL parameters
  $request = \Drupal::request();
  $parameters = [
    'nom_d_entreprise' => $request->query->get('nom_d_entreprise'),
    'email' => $request->query->get('email'),
    'opportunite_id' => $request->query->get('opportunite_id'),
  ];
  
  // Initialize default values array
  $default_values = [];
  
  // 1. First get connected user data if available
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated()) {
    $user = \Drupal\user\Entity\User::load($current_user->id());
    if ($user) {
      $default_values['nom'] = $user->getDisplayName(); // Nom complet field seen in screenshot
      $default_values['courriel'] = $user->getEmail(); // Courriel field seen in screenshot
      
      // Récupérer le profil exportateur (type de contenu) associé à l'utilisateur
      try {
        // Requête pour trouver les noeuds de type "profile_exportateur" liés à l'utilisateur courant
        $query = \Drupal::entityQuery('node')
          ->condition('type', 'profile_exportateur')
          ->condition('uid', $current_user->id())
          ->accessCheck(TRUE)
          ->sort('created', 'DESC') // Prendre le plus récent si plusieurs existent
          ->range(0, 1);
        
        $nids = $query->execute();
        
        if (!empty($nids)) {
          $nid = reset($nids);
          $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
          
          if ($node && $node->hasField('field_secteur') && !$node->get('field_secteur')->isEmpty()) {
            // Récupération du champ secteur selon son type
            $field_secteur = $node->get('field_secteur');
            
            // Si c'est une référence à un terme de taxonomie
            if ($field_secteur->entity) {
              $default_values['secteur_d_activite'] = $field_secteur->entity->label();
            }
            // Si c'est une valeur simple (texte, etc.)
            else {
              $value = $field_secteur->getValue();
              if (isset($value[0]['value'])) {
                $default_values['secteur_d_activite'] = $value[0]['value'];
              }
            }
            
            \Drupal::logger('cepex_webform')->notice('Secteur trouvé pour l\'utilisateur: @secteur', [
              '@secteur' => $default_values['secteur_d_activite'] ?? 'non défini'
            ]);
          }
        } else {
          \Drupal::logger('cepex_webform')->notice('Aucun nœud de type profile_exportateur trouvé pour l\'utilisateur @uid', [
            '@uid' => $current_user->id()
          ]);
        }
      }
      catch (\Exception $e) {
        \Drupal::logger('cepex_webform')->error('Erreur lors de la récupération du secteur: @error', [
          '@error' => $e->getMessage()
        ]);
      }
    }
  }
  
  // 2. Then apply URL parameters (they override user data if present)
  foreach ($parameters as $param_key => $param_value) {
    if (!empty($param_value)) {
      $decoded_value = urldecode($param_value);
      
      // Map URL parameter names to exact form field keys from screenshot
      switch ($param_key) {
        case 'nom_d_entreprise':
          $default_values['nom_d_entreprise'] = $decoded_value;
          break;
        case 'email':
          $default_values['courriel'] = $decoded_value; // Use 'courriel' as seen in screenshot
          break;
        case 'opportunite_id':
          $default_values['nom_d_opportunite'] = $decoded_value; // Use field key from screenshot
          break;
      }
    }
  }
  
  // Log all parameters for debugging
  $debug_message = 'Valeurs par défaut à appliquer: ' . print_r($default_values, TRUE);
  \Drupal::logger('cepex_webform')->notice($debug_message);
  
  // No values to set, exit early
  if (empty($default_values)) {
    return;
  }
  
  // Apply values using multiple reliable methods
  
  // Method 1: Using #default_data for the form
  $form['#default_data'] = isset($form['#default_data']) 
    ? array_merge($form['#default_data'], $default_values) 
    : $default_values;
  
  // Method 2: Directly set default values on the elements
  if (isset($form['elements']) && is_array($form['elements'])) {
    foreach ($default_values as $field_key => $value) {
      if (isset($form['elements'][$field_key])) {
        $form['elements'][$field_key]['#default_value'] = $value;
        // Also set #value to ensure field is populated
        $form['elements'][$field_key]['#value'] = $value;
      }
    }
  }
  
  // Method 3: Set values directly via form_state storage
  $storage = $form_state->getStorage();
  $storage['webform_values'] = $default_values;
  $form_state->setStorage($storage);
  
  // Method 4: Create a webform submission with values
  $webform = $form_state->getFormObject()->getWebform();
  if ($webform) {
    $submission_storage = \Drupal::entityTypeManager()->getStorage('webform_submission');
    $submission = $submission_storage->create([
      'webform_id' => $webform->id(),
      'data' => $default_values,
    ]);
    $form_state->set('webform_submission', $submission);
  }
  
  // Method 5: Add direct alter hook to ensure fields are populated during rendering
  $form['#after_build'][] = function($form, $form_state) use ($default_values) {
    foreach ($default_values as $key => $value) {
      if (isset($form['elements'][$key]['#default_value'])) {
        $form['elements'][$key]['#default_value'] = $value;
        $form['elements'][$key]['#value'] = $value;
      }
    }
    return $form;
  };
}

  
  if (strpos($form_id, 'webform_submission_demande_de_devis_') === 0) {
    // On attache la librairie contenant webform-custom.css
    $form['#attached']['library'][] = 'cepex/form-contact';
    
    // Récupérer les paramètres de l'URL
    $nom_de_produit = \Drupal::request()->query->get('nom_de_produit');
    
    // Récupérer l'utilisateur connecté
    $current_user = \Drupal::currentUser();
    
    // Vérifier si un utilisateur est connecté
    if ($current_user->isAuthenticated()) {
      // Charger l'utilisateur complet pour accéder à toutes ses propriétés
      $user = \Drupal\user\Entity\User::load($current_user->id());
      
      // Récupérer le nom d'utilisateur
      $user_name = $user->getDisplayName();
      
      // Récupérer l'email de l'utilisateur
      $user_mail = $user->getEmail();
      
      // Appliquer les valeurs aux champs du formulaire si disponibles
      
      // Nom de l'utilisateur (contact)
      if (isset($form['elements']['contact'])) {
        $form['elements']['contact']['#default_value'] = $user_name;
      }
      
      // Email de l'utilisateur
      if (isset($form['elements']['courriel'])) {
        $form['elements']['courriel']['#default_value'] = $user_mail;
      }
    }
    
    // Récupération de la description du produit
    $description_produit = \Drupal::request()->query->get('description_produit');
    
    // Si pas de description dans l'URL mais que le nom du produit est défini, 
    // chercher le produit et sa description dans la base de données
    if (!empty($nom_de_produit) && empty($description_produit)) {
      // Trouver le nœud du produit par son titre
      $query = \Drupal::entityQuery('node')
        ->condition('type', 'produit') // Remplacer par le type de contenu réel du produit
        ->condition('title', urldecode($nom_de_produit))
        ->range(0, 1);
      $nids = $query->execute();
      
      // Si un produit est trouvé
      if (!empty($nids)) {
        $nid = reset($nids);
        $node = \Drupal\node\Entity\Node::load($nid);
        
        // Si le nœud a le champ field_description_produit
        if ($node && $node->hasField('field_description_produit') && !$node->get('field_description_produit')->isEmpty()) {
          $description_produit = $node->get('field_description_produit')->value;
          \Drupal::messenger()->addMessage('Description du produit récupérée depuis la base de données.');
        }
      }
    }
    
    // Remplir le champ description_de_produit avec la description trouvée
    if (!empty($description_produit)) {
      $decoded_description = urldecode($description_produit);
      
      // Tenter de remplir le champ description_de_produit de différentes manières
      // Approche 1: directement dans les éléments du formulaire
      if (isset($form['elements']['description_de_produit'])) {
        $form['elements']['description_de_produit']['#default_value'] = $decoded_description;
        $form['elements']['description_de_produit']['#value'] = $decoded_description;
        
        // Si c'est un champ textfield ou textarea standard
        if (isset($form['elements']['description_de_produit']['#type']) && 
            ($form['elements']['description_de_produit']['#type'] == 'textfield' || 
             $form['elements']['description_de_produit']['#type'] == 'textarea')) {
          $form['elements']['description_de_produit']['#attributes']['value'] = $decoded_description;
        }
      }
      
      
      // Approche 3: chercher le champ avec #webform_key = description_de_produit
      foreach ($form as $key => &$element) {
        if (is_array($element) && isset($element['#webform_key']) && $element['#webform_key'] === 'description_de_produit') {
          $element['#default_value'] = $decoded_description;
          $element['#value'] = $decoded_description;
          \Drupal::messenger()->addMessage('Champ description trouvé et modifié via #webform_key: ' . $key);
          break;
        }
      }
    }
    
    // Gérer le champ nom_de_produit indépendamment de la connexion utilisateur
    if (!empty($nom_de_produit)) {
      // Décode la valeur
      $decoded_value = urldecode($nom_de_produit);
      
      // Approche 1: via le state du formulaire
      $webform = $form_state->getFormObject()->getWebform();
      $storage = \Drupal::entityTypeManager()->getStorage('webform_submission');
      $values = ['data' => ['nom_de_produit' => $decoded_value]];
      
      // Ajouter la description du produit aux valeurs si disponible
      if (!empty($description_produit)) {
        $values['data']['description_de_produit'] = urldecode($description_produit);
      }
      
      $submission = $storage->create(['webform_id' => $webform->id(), 'data' => $values['data']]);
      $form_state->setValues($values);
      $form_state->set('submission', $submission);
      
      // Approche 2: modifier directement les éléments du formulaire
      if (isset($form['elements']['nom_de_produit'])) {
        $form['elements']['nom_de_produit']['#default_value'] = $decoded_value;
        $form['elements']['nom_de_produit']['#value'] = $decoded_value;
        
        // Si c'est un champ textfield standard
        if (isset($form['elements']['nom_de_produit']['#type']) && 
            ($form['elements']['nom_de_produit']['#type'] == 'textfield' || 
             $form['elements']['nom_de_produit']['#type'] == 'textarea')) {
          $form['elements']['nom_de_produit']['#attributes']['value'] = $decoded_value;
        }
      }
      
     
    
      
      // Approche 5: Chercher le champ avec #webform_key = nom_de_produit
      foreach ($form as $key => &$element) {
        if (is_array($element) && isset($element['#webform_key']) && $element['#webform_key'] === 'nom_de_produit') {
          $element['#default_value'] = $decoded_value;
          $element['#value'] = $decoded_value;
          break;
        }
      }
      
      // Si tout échoue, affichons plus d'informations sur le formulaire
      if (function_exists('dpm') || function_exists('kint')) {
        // Si Devel est activé, utilisons ses fonctions pour un meilleur débogage
        if (function_exists('dpm')) {
          dpm($form, 'Structure du formulaire');
          dpm($form_state, 'État du formulaire');
        } else if (function_exists('kint')) {
          kint($form);
          kint($form_state);
        }
      } else {
        // Sinon, affichons au moins des informations basiques
        $form_keys = array_keys($form);
        $elements_keys = isset($form['elements']) ? array_keys($form['elements']) : [];
        \Drupal::messenger()->addMessage('Clés du formulaire: ' . implode(', ', $form_keys));
        \Drupal::messenger()->addMessage('Clés des éléments: ' . implode(', ', $elements_keys));
      }
    }
  }
  
  // Formulaire pour gestion-produit-par-exportateur
  if ($form_id == 'views_exposed_form' && $form['#id'] == 'views-exposed-form-gestion-produit-par-exportateur-page-1') {
    _cepex_setup_filter_form($form);
  }
  // Formulaire pour gestion-exportateurs
  elseif ($form_id == 'views_exposed_form' && $form['#id'] == 'views-exposed-form-gestion-exportateurs-page-1') {
    _cepex_setup_filter_form_exportateurs($form);
  }
  elseif ($form_id == 'views_exposed_form' && $form['#id'] == 'views-exposed-form-les-produits-de-l-exportateur') {
    _cepex_setup_filter_form_exportateurs($form);
  }
  elseif ($form_id == 'views_exposed_form' && $form['#id'] == 'views-exposed-form-market-place-page-1') {
    _cepex_setup_filter_form_exportateurs($form);
  }
}


/**
 * Helper function pour configurer le formulaire de filtres de produits
 */
function _cepex_setup_filter_form(&$form) {
  // Ajouter un conteneur flex pour aligner les éléments.
  $form['#attributes']['class'][] = 'filter-flex-container';

  // Déplacer le champ "title" dans le groupe en affichant son label.
  if (isset($form['title'])) {
    // Attribuer le texte du label et forcer son affichage avant l'élément.
    $form['title']['#title'] = t('Mot clé');
    $form['title']['#title_display'] = 'before';
    $form['filter_group']['title'] = $form['title'];
    unset($form['title']);
  }


  // Personnaliser le conteneur des actions.
  if (isset($form['actions'])) {
    $form['actions']['#attributes']['class'][] = 'form-actions-centered';
    $form['actions']['submit']['#attributes']['class'][] = 'btn';
    $form['actions']['submit']['#attributes']['class'][] = 'btn-primary';
    $form['actions']['submit']['#attributes']['class'][] = 'search-btn-rounded';
  }

  // Ajouter un traitement après la construction du formulaire.
  $form['#after_build'][] = 'cepex_filter_form_after_build';
}

/**
 * Helper function pour configurer le formulaire de filtres des exportateurs
 */
function _cepex_setup_filter_form_exportateurs(&$form) {
  // Ajouter un conteneur flex pour aligner les éléments.
  $form['#attributes']['class'][] = 'filter-flex-container';

  // Grouper les éléments de filtre.
  $form['filter_group'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['filter-elements-group', 'flex-aligned'],
    ],
    '#weight' => -10,
  ];

  // Déplacer le champ "matricule fiscale" dans le groupe en affichant son label.
  if (isset($form['field_matricule_fiscale_value'])) {
    $form['field_matricule_fiscale_value']['#title'] = t('Matricule fiscale');
    $form['field_matricule_fiscale_value']['#title_display'] = 'before';
    $form['field_matricule_fiscale_value']['#attributes']['class'][] = 'search-input-styled';
    $form['filter_group']['field_matricule_fiscale_value'] = $form['field_matricule_fiscale_value'];
    unset($form['field_matricule_fiscale_value']);
  }

  // Déplacer le champ "nom de l'entreprise" dans le groupe.
  if (isset($form['field_nom_de_l_entreprise_value'])) {
    $form['field_nom_de_l_entreprise_value']['#title'] = t('Nom d\'entreprise');
    $form['field_nom_de_l_entreprise_value']['#title_display'] = 'before';
    $form['field_nom_de_l_entreprise_value']['#attributes']['class'][] = 'search-input-styled';
    $form['filter_group']['field_nom_de_l_entreprise_value'] = $form['field_nom_de_l_entreprise_value'];
    unset($form['field_nom_de_l_entreprise_value']);
  }

  // Personnaliser le conteneur des actions.
  if (isset($form['actions'])) {
    $form['actions']['#attributes']['class'][] = 'form-actions-centered';
    $form['actions']['submit']['#attributes']['class'][] = 'btn';
    $form['actions']['submit']['#attributes']['class'][] = 'btn-primary';
    $form['actions']['submit']['#attributes']['class'][] = 'search-btn-rounded';
  }

  // Ajouter un traitement après la construction du formulaire.
  $form['#after_build'][] = 'cepex_filter_form_after_build';
}

/**
 * After build callback pour le formulaire de filtres.
 */
function cepex_filter_form_after_build($form, &$form_state) {
  // Ajouter des attributs supplémentaires une fois le formulaire construit
  if (isset($form['filter_group'])) {
    $form['filter_group']['#attributes']['class'][] = 'filter-group-processed';
  }
  
  return $form;
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function cepex_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#form_id'])) {
    $form_id = $variables['element']['#form_id'];
    
    // Suggestions de template pour tous les formulaires
    $suggestions[] = 'form__' . str_replace('-', '_', $form_id);
    
    // Pour les formulaires exposés de vues spécifiquement
    if ($form_id == 'views_exposed_form' && isset($variables['element']['#id'])) {
      $id = $variables['element']['#id'];
      
      // Ajouter une suggestion générique pour tous les formulaires exposés
      $suggestions[] = 'form__views_exposed_form';
      
      // Suggestions spécifiques selon l'ID du formulaire
      if ($id == 'views-exposed-form-gestion-produit-par-exportateur-page-1') {
        $suggestions[] = 'form__marketplace_filters';
        $suggestions[] = 'form__gestion_produit_marketplace';
      }
      elseif ($id == 'views-exposed-form-gestion-exportateurs-page-1') {
        $suggestions[] = 'form__exportateurs_filters';
        $suggestions[] = 'form__gestion_exportateurs_marketplace';
      }
      // Version sans le suffixe page-1 pour plus de flexibilité
      elseif ($id == 'views-exposed-form-les-produits-de-l-exportateur') {
        $suggestions[] = 'form__exportateurs_filters';
        $suggestions[] = 'form__gestion_produit_secteur';
        // Nouvelles suggestions plus spécifiques
        $suggestions[] = 'form__views_exposed_form__les_produits_de_l_exportateur';
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for container.
 */
function cepex_theme_suggestions_container_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#id']) && $variables['element']['#id'] == 'edit-actions') {
    $suggestions[] = 'container__actions';
    $suggestions[] = 'container__filter_actions';
  }
  
  if (isset($variables['element']['#attributes']['class']) && 
      in_array('filter-elements-group', $variables['element']['#attributes']['class'])) {
    $suggestions[] = 'container__filter_group';
  }
}


/**
 * Implements hook_theme_suggestions_HOOK_alter() for input element.
 */
function cepex_theme_suggestions_input_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#id'])) {
    // Pour les champs de recherche
    if (in_array($variables['element']['#id'], [
      'edit-title', 
      'edit-field-matricule-fiscale-value',
      'edit-field-nom-de-l-entreprise-value'
    ])) {
      $suggestions[] = 'input__search_field';
    }
    
    // Pour les boutons de soumission de formulaire
    if (in_array($variables['element']['#id'], [
      'edit-submit-gestion-produit-par-exportateur',
      'edit-submit-gestion-exportateurs',
      'edit-submit-les-produits-de-l-exportateur'
    ])) {
      $suggestions[] = 'input__search_submit';
    }
    
  }
}
/**
 * Implements hook_theme_suggestions_views_view_table_alter().
 */
function cepex_theme_suggestions_views_view_table_alter(array &$suggestions, array $variables) {
  // Obtenir l'ID de la vue
  if (isset($variables['view'])) {
    $view_id = $variables['view']->id();
    $display_id = $variables['view']->current_display;
    
    // Ajouter des suggestions basées sur l'ID de la vue
    $suggestions[] = 'views_view_table__' . $view_id;
    $suggestions[] = 'views_view_table__' . $view_id . '__' . $display_id;
    
    // Cibler spécifiquement la vue "les_produits_de_l_exportateur"
    if ($view_id == 'les_produits_de_l_exportateur') {
      $suggestions[] = 'views_view_table__produits_exportateur';
      
      // Si vous avez besoin de suggestions encore plus spécifiques basées sur l'affichage
      if ($display_id) {
        $suggestions[] = 'views_view_table__produits_exportateur__' . $display_id;
      }
    }
   
  }
}

/**
 * Implements hook_theme_suggestions_views_view_alter().
 */
function cepex_theme_suggestions_views_view_alter(array &$suggestions, array $variables) {
  $view = $variables['view'];
  
  // Suggestions pour la vue gestion_exportateurs_par_homme_secteur
  if ($view->id() == 'gestion_exportateurs' && $view->current_display == 'page_1') {
    $suggestions[] = 'views_view__' . $view->id();
    $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
    $suggestions[] = 'views_view__exportateurs';
    
    // Ajouter des suggestions basées sur les arguments de la vue
    if (!empty($view->args)) {
      $suggestions[] = 'views_view__' . $view->id() . '__arg_' . $view->args[0];
    }
  }
  
  // Suggestions pour la vue les-produits-de-l-exportateur
  if ($view->id() == 'les-produits-de-l-exportateur') {
    $suggestions[] = 'views_view__' . $view->id();
    
    // Note: remplacer les tirets par des underscores pour la suggestion
    $suggestions[] = 'views_view__les_produits_de_l_exportateur';
    
    // Suggestion avec le display actuel
    if (!empty($view->current_display)) {
      $suggestions[] = 'views_view__' . $view->id() . '__' . $view->current_display;
    }
    
    // Ajouter des suggestions basées sur les arguments de la vue
    if (!empty($view->args)) {
      $suggestions[] = 'views_view__' . $view->id() . '__arg_' . $view->args[0];
    }
  }
}
function cepex_theme_suggestions_views_view_unformatted_alter(array &$suggestions, array $variables) {
  if (isset($variables['view'])) {
    $view = $variables['view'];
    $suggestions[] = 'views_view_unformatted__' . $view->id();
    $suggestions[] = 'views_view_unformatted__' . $view->id() . '__' . $view->current_display;
  }
}

function cepex_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  
  // Ajout de suggestions spécifiques
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
  
  // Pour les nodes dans des vues spécifiques
  if (isset($variables['elements']['#view_id'])) {
    $suggestions[] = 'node__' . $variables['elements']['#view_id'];
    $suggestions[] = 'node__' . $node->bundle() . '__' . $variables['elements']['#view_id'];
    $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode . '__' . $variables['elements']['#view_id'];
  }
}
